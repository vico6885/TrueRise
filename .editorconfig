# Consistent editing across Rust, Python, TOML and Markdown.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown line breaks are semantic in tables and diffs.
trim_trailing_whitespace = false
max_line_length = off

[Makefile]
indent_style = tab

[*.hex]
indent_size = 2
