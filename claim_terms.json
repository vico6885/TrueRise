  "terms": [
    {
      "term": "Harness",
      "status": "met",
      "meaning": "one real run path chains model calls, tool execution, judging and the audit ledger",
      "command": "cargo test -p truerise-cli --test evolve_gate",
      "test": "evolve_gen0_to_gen1_produces_lineage_certificate",
      "artifact": "readings/v0.2/gen1_certificate.json"
    },
    {
      "term": "Governance",
      "status": "met",
      "meaning": "policy/budget/approval/ratchet can stop a live run, not only pass unit tests",
      "command": "cargo test -p truerise-cli --test budget_enforcement",
      "test": "budget_exhaustion_halts_run_at_step_n",
      "artifact": "baselines/run_scores.json"
    },
    {
      "term": "Verifiable",
      "status": "met",
      "meaning": "a third party can recompute offline AND verify who issued the certificate",
      "command": "cargo test -p truerise-cli --test cert_identity",
      "test": "tampered_certificate_fails_signature_check",
      "artifact": "docs/rfc/0003-generation-certificate-and-apply.md"
    },
    {
      "term": "Recursive Self-Improvement",
      "status": "met",
      "meaning": "one generation gen0->gen1 runs end to end: propose -> human approval -> apply -> re-eval -> ratchet -> (rollback on regression), recomputable offline",
      "command": "cargo run -p truerise-cli -- evolve --replay --cert readings/v0.2/gen1_certificate.json",
      "test": "generation_certificate_recomputes_identically_offline",
      "artifact": "readings/v0.2/gen1_certificate.json"
    },
    {
      "term": "Deterministic",
      "status": "met",
      "meaning": "pinned model steps + recorded tape + hash-chained ledger recompute to identical digests offline (harness mechanics; model outputs themselves are NOT claimed deterministic)",
      "command": "cargo test -p truerise-cli --test tape_replay",
      "test": "same_tape_replays_identical_digest",
      "artifact": "docs/determinism.md"
    }
  ],
